# Orbiter's Plymouth theme: a dot-matrix wordmark, a typed-out boot log
# (playful lines while the kernel starts, then the real services), a mission
# clock and block-cell progress. src/boot/plymouth_assets.py turns this template
# into orbiter.script; dev/boot-animation.qml previews the same design.
#
# Every piece of text is an image (no fonts this early in boot): fixed
# strings are label-*.png, and the log is composed from one image per
# character. Layout is designed for a 2400 px tall screen and scaled by S.
#
# Plymouth script notes: inside functions, writes to globals need `global.`;
# there is no % operator, ternary or number-to-string, hence the helpers.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

W = Window.GetWidth();
H = Window.GetHeight();
X0 = Window.GetX();
Y0 = Window.GetY();
S = H / 2400;
MARGIN = 150 * S;

mode = Plymouth.GetMode();
shutting_down = 0;
if (mode == "shutdown" || mode == "reboot")
  shutting_down = 1;

# Seconds since the splash appeared. Frames don't arrive at a steady 50 a
# second while the machine is busy booting, so each frame adds 0.02 but the
# clock also catches up to Plymouth's own elapsed time whenever it reports
# progress; animations run in real time however slowly frames come.
t = 0;
elapsed = 0;
progress = 0;
root_mounted = 0;

# --- Helpers -----------------------------------------------------------------

# Images are drawn for a 2400 px tall screen; on one, skip the costly Scale.
fun scaled(name)
{
  local.image = Image(name);
  if (S == 1)
    return image;
  return image.Scale(Math.Int(image.GetWidth() * S + 0.5), Math.Int(image.GetHeight() * S + 0.5));
}

fun mod(a, b)
{
  return a - Math.Int(a / b) * b;
}

fun clamp(x, lo, hi)
{
  if (x < lo)
    return lo;
  if (x > hi)
    return hi;
  return x;
}

DIGITS = "0123456789";

fun digits(n, width)
{
  local.out = "";
  local.i;
  n = Math.Int(n);
  for (i = 0; i < width; i++)
    {
      out = DIGITS.CharAt(mod(n, 10)) + out;
      n = Math.Int(n / 10);
    }
  return out;
}

fun repeat(ch, n)
{
  local.out = "";
  local.i;
  for (i = 0; i < n; i++)
    out = out + ch;
  return out;
}

# --- Glyphs ------------------------------------------------------------------

@GLYPH_TABLE@

GW = Math.Int(@GLYPH_W@ * S + 0.5);
GH = Math.Int(@GLYPH_H@ * S + 0.5);
glyph_cache.dummy = 0;

fun glyph(colour, ch)
{
  local.file = glyph_file[ch];
  if (!file)
    file = "063";
  local.key = colour + "-" + file;
  if (!glyph_cache[key])
    glyph_cache[key] = scaled("glyphs/" + key + ".png");
  return glyph_cache[key];
}

# A run of character sprites showing one string, e.g. the clock.
fun text_row(x, y, z, count)
{
  local.row;
  local.i;
  for (i = 0; i < count; i++)
    {
      row.sprite[i] = Sprite();
      row.sprite[i].SetPosition(x + i * GW, y, z);
      row.key[i] = "";
    }
  row.count = count;
  return row;
}

fun set_text(row, colour, text)
{
  local.i;
  local.ch;
  for (i = 0; i < row.count; i++)
    {
      ch = " ";
      if (i < text.Length())
        ch = text.CharAt(i);
      if (row.key[i] != colour + ch)
        {
          row.key[i] = colour + ch;
          if (ch == " ")
            row.sprite[i].SetOpacity(0);
          else
            {
              row.sprite[i].SetImage(glyph(colour, ch));
              row.sprite[i].SetOpacity(1);
            }
        }
    }
}

# --- Static pieces -----------------------------------------------------------

background.image = Image("background.png");
if (background.image.GetWidth() != W || background.image.GetHeight() != H)
  background.image = background.image.Scale(W, H);
background.sprite = Sprite(background.image);
background.sprite.SetPosition(X0, Y0, -100);

header.sprite = Sprite(scaled("label-header-boot.png"));
if (shutting_down)
  header.sprite.SetImage(scaled("label-header-shutdown.png"));
header.sprite.SetPosition(X0 + MARGIN, Y0 + MARGIN, 10);

stage.kernel = scaled("label-stage-kernel.png");
stage.services = scaled("label-stage-services.png");
stage.login = scaled("label-stage-login.png");
stage.shutdown = scaled("label-stage-shutdown.png");
stage.sprite = Sprite(stage.kernel);
if (shutting_down)
  stage.sprite.SetImage(stage.shutdown);
stage.sprite.SetPosition(X0 + MARGIN, Y0 + MARGIN + 62 * S, 10);

node.image = scaled("label-node.png");
node.sprite = Sprite(node.image);
node.sprite.SetPosition(X0 + W - MARGIN - node.image.GetWidth(), Y0 + MARGIN + 70 * S, 10);

# T+00:00.00, right-aligned under the corner.
clock = text_row(X0 + W - MARGIN - 10 * GW, Y0 + MARGIN, 10, 10);

# The wordmark, lighting up dot by dot over the first half second, with the
# odd glitch. Frames load as they're first shown, so the splash starts sooner.
wordmark.x = X0 + MARGIN;
wordmark.y = Y0 + 560 * S;
wordmark.sprite = Sprite();
wordmark.sprite.SetPosition(wordmark.x, wordmark.y, 10);
wordmark.shown = -1;
glitch.sprite = Sprite(scaled("wordmark-glitch.png"));
glitch.sprite.SetPosition(wordmark.x + 14 * S, wordmark.y, 9);
glitch.sprite.SetOpacity(0);


# --- Progress ----------------------------------------------------------------

CELLS = 48;
cell.on = scaled("cell-on.png");
cell.off = scaled("cell-off.png");
bar.y = Y0 + H - 270 * S;
bar.label = Sprite(scaled("label-boot.png"));
bar.label.SetPosition(X0 + MARGIN, bar.y, 10);
bar.x = X0 + MARGIN + 140 * S;
for (i = 0; i < CELLS; i++)
  {
    bar.cell[i] = Sprite(cell.off);
    bar.cell[i].SetPosition(bar.x + i * 20 * S, bar.y, 10);
  }
bar.lit = 0;
bar.percent = text_row(bar.x + CELLS * 20 * S + 24 * S, bar.y, 10, 5);

fun show_progress(fraction)
{
  local.lit = Math.Int(clamp(fraction, 0, 1) * CELLS + 0.5);
  local.i;
  if (lit != bar.lit)
    {
      for (i = 0; i < CELLS; i++)
        {
          if (i < lit)
            bar.cell[i].SetImage(cell.on);
          else
            bar.cell[i].SetImage(cell.off);
        }
      bar.lit = lit;
    }
  local.p = Math.Int(clamp(fraction, 0, 1) * 100 + 0.5);
  local.words = digits(p, 3) + " %";
  if (p < 100)
    words = " " + digits(p, 2) + " %";
  if (p < 10)
    words = "  " + digits(p, 1) + " %";
  set_text(bar.percent, "text", words);
}

# The shutdown screen has no progress to show.
if (shutting_down)
  {
    bar.label.SetOpacity(0);
    for (i = 0; i < CELLS; i++)
      bar.cell[i].SetOpacity(0);
  }

# --- The log -----------------------------------------------------------------
#
# lines[n] = { kind, text, born }, kind one of playful / service / message /
# final / prompt. The newest nine are drawn, typed out at 70 characters a
# second; older ones dim.

SLOTS = 9;
COLS = 96;
TYPE_RATE = 70;
log.x = X0 + MARGIN;
log.y = Y0 + 1020 * S;
log.line_h = GH + 8 * S;
for (i = 0; i < SLOTS; i++)
  {
    slot[i] = text_row(log.x, log.y + i * log.line_h, 10, COLS);
    slot[i].line = -1;
    slot[i].settled = 0;
    slot[i].opacity = 1;
  }
# Created here: arrays first written inside a function would be local to it.
lines[0].kind = "none";
line_count = 0;
cursor.sprite = Sprite(scaled("cursor.png"));
cursor.sprite.SetOpacity(0);

fun add_line(kind, text, born)
{
  if (text.Length() > COLS - 12)
    text = text.SubString(0, COLS - 12);
  lines[line_count].kind = kind;
  lines[line_count].text = text;
  lines[line_count].born = born;
  global.line_count = line_count + 1;
}

# Playful lines, scheduled while the kernel starts.
if (shutting_down)
  {
    flavour[0] = "STOWING STAR CHARTS";
    flavour[1] = "PARKING REACTOR";
    flavour[2] = "SAYING GOODBYE TO NAV COMPUTER";
    flavour[3] = "POWER CORE SAFE";
  }
else
  {
    flavour[0] = "POWER CORE";
    flavour[1] = "CALIBRATING STAR CHARTS";
    flavour[2] = "SPOOLING REACTOR";
    flavour[3] = "HANDSHAKE WITH NAV COMPUTER";
    flavour[4] = "WARMING DOT MATRIX";
  }
for (i = 0; flavour[i]; i++)
  add_line("playful", flavour[i], 0.3 + i * 0.2);
flavour_end = 0.3 + i * 0.2;

# Real services queue up and join the log at most every 0.12 s, so a burst
# stays readable; a long backlog skips ahead to keep up with the boot.
pending[0] = "";
pending_count = 0;
pending_next = 0;
last_service = 0;

fun update_status_callback(status)
{
  local.name = status;
  if (name.Length() > 8 && name.SubString(name.Length() - 8, name.Length()) == ".service")
    name = name.SubString(0, name.Length() - 8);
  pending[pending_count] = name;
  global.pending_count = pending_count + 1;
}

fun line_length(line)
{
  if (line.kind == "service")
    return 8 + line.text.Length();
  return line.text.Length();
}

# Draws line `n` into slot `s` as it should look at time t; returns 1 once it
# has finished typing and won't change again.
fun draw_line(s, n)
{
  local.line = lines[n];
  local.age = t - line.born;
  local.length = line_length(line);
  local.typed = clamp(Math.Int(age * TYPE_RATE), 0, length);
  local.done = 0;
  if (age > length / TYPE_RATE + 0.12)
    done = 1;

  local.col = 0;
  local.out = "";

  if (line.kind == "service")
    {
      if (done)
        set_text_at(s, 0, "ok", "[  OK  ] ");
      else
        set_text_at(s, 0, "dim", "[  ..  ] ");
      col = 9;
      out = "Started " + line.text;
      set_text_at(s, col, "text", out.SubString(0, typed) + repeat(" ", length - typed));
      col = col + length;
    }
  else if (line.kind == "playful")
    {
      set_text_at(s, 0, "accent", "> ");
      col = 2;
      set_text_at(s, col, "text", line.text.SubString(0, typed) + repeat(" ", length - typed));
      col = col + length;
      if (typed >= length)
        {
          local.dots = 34 - length;
          if (dots < 2)
            dots = 2;
          set_text_at(s, col, "dim", " " + repeat(".", dots));
          col = col + 1 + dots;
          if (done)
            set_text_at(s, col, "ok", " [ OK ]");
          col = col + 7;
        }
    }
  else if (line.kind == "prompt")
    {
      set_text_at(s, 0, "accent", "> " + line.text);
      col = 2 + line.text.Length();
      done = 0;
    }
  else
    {
      set_text_at(s, 0, "accent", line.text.SubString(0, typed) + repeat(" ", length - typed));
      col = length;
    }

  # Clear the rest of the row.
  set_text_at(s, col, "text", repeat(" ", COLS - col));
  global.slot[s].typed_col = col;
  if (line.kind == "service")
    global.slot[s].typed_col = 9 + typed;
  else if (line.kind == "playful" && typed < length)
    global.slot[s].typed_col = 2 + typed;
  return done;
}

fun set_text_at(s, start, colour, text)
{
  local.i;
  local.ch;
  for (i = 0; i < text.Length() && start + i < COLS; i++)
    {
      ch = text.CharAt(i);
      if (slot[s].key[start + i] != colour + ch)
        {
          slot[s].key[start + i] = colour + ch;
          if (ch == " ")
            slot[s].sprite[start + i].SetOpacity(0);
          else
            {
              slot[s].sprite[start + i].SetImage(glyph(colour, ch));
              slot[s].sprite[start + i].SetOpacity(slot[s].opacity);
            }
        }
    }
}

fun set_slot_opacity(s, opacity)
{
  local.i;
  if (slot[s].opacity == opacity)
    return;
  global.slot[s].opacity = opacity;
  for (i = 0; i < COLS; i++)
    if (slot[s].key[i] != "" && slot[s].key[i].CharAt(slot[s].key[i].Length() - 1) != " ")
      slot[s].sprite[i].SetOpacity(opacity);
}

fun draw_log()
{
  local.visible = 0;
  local.first = 0;
  local.s;
  local.n;
  # Lines whose time has come.
  for (n = 0; n < line_count; n++)
    if (lines[n].born <= t)
      visible = n + 1;
  first = visible - SLOTS;
  if (first < 0)
    first = 0;
  for (s = 0; s < SLOTS; s++)
    {
      n = first + s;
      if (n >= visible)
        {
          if (slot[s].line != -1)
            {
              set_text_at(s, 0, "text", repeat(" ", COLS));
              global.slot[s].line = -1;
            }
        }
      else
        {
          # Older lines dim, so the eye follows the newest.
          set_slot_opacity(s, 0.45 + 0.55 * (s + 1 + SLOTS - (visible - first)) / SLOTS);
          if (slot[s].line != n || !slot[s].settled)
            {
              global.slot[s].line = n;
              global.slot[s].settled = draw_line(s, n);
            }
        }
    }
  # The cursor rides the newest line, blinking.
  if (visible > 0 && mod(Math.Int(t * 3), 2) == 0)
    {
      s = visible - 1 - first;
      cursor.sprite.SetPosition(log.x + slot[s].typed_col * GW, log.y + s * log.line_h + 4 * S, 11);
      cursor.sprite.SetOpacity(1);
    }
  else
    cursor.sprite.SetOpacity(0);
}

# --- Each frame ----------------------------------------------------------------

final_shown = 0;

fun refresh_callback()
{
  global.t = t + 0.02;
  if (elapsed > t)
    global.t = elapsed;

  local.frame = clamp(Math.Int(t / 0.5 * 24), 0, 23);
  if (frame != wordmark.shown)
    {
      if (!wordmark.frame[frame])
        wordmark.frame[frame] = scaled("wordmark-" + digits(frame, 2) + ".png");
      wordmark.sprite.SetImage(wordmark.frame[frame]);
      wordmark.shown = frame;
    }
  if (t > 1 && mod(t, 2.7) < 0.09)
    {
      wordmark.sprite.SetX(wordmark.x - 8 * S);
      glitch.sprite.SetOpacity(0.8);
    }
  else
    {
      wordmark.sprite.SetX(wordmark.x);
      glitch.sprite.SetOpacity(0);
    }

  local.minutes = Math.Int(t / 60);
  local.seconds = mod(t, 60);
  set_text(clock, "text", "T+" + digits(minutes, 2) + ":" + digits(seconds, 2) + "." + digits(seconds * 100, 2));

  # Services join once the playful lines are done.
  if (t >= flavour_end && pending_next < pending_count && t - last_service >= 0.12)
    {
      if (pending_count - pending_next > 12)
        global.pending_next = pending_count - 4;
      add_line("service", pending[pending_next], t);
      global.pending_next = pending_next + 1;
      global.last_service = t;
    }

  if (!shutting_down)
    {
      show_progress(progress);
      if (progress > 0.95)
        {
          stage.sprite.SetImage(stage.login);
          if (!final_shown)
            {
              add_line("final", "ALL SYSTEMS NOMINAL // HANDING OFF TO LOGIN", t);
              global.final_shown = 1;
            }
        }
      else if (root_mounted)
        stage.sprite.SetImage(stage.services);
    }

  draw_log();
}

# `duration` is how long Plymouth has been running: the real-time clock.
fun boot_progress_callback(duration, fraction)
{
  global.progress = fraction;
  global.elapsed = duration;
}

fun system_update_callback(percent)
{
  global.progress = percent / 100;
}

fun root_mounted_callback()
{
  global.root_mounted = 1;
}

fun display_message_callback(text)
{
  add_line("message", text, t);
}

# Password and question prompts (disk encryption and the like) join the log
# as a live line: the prompt, then a star per character typed.
prompt_line = -1;

fun show_prompt(text)
{
  if (prompt_line < 0)
    {
      global.prompt_line = line_count;
      add_line("prompt", text, t);
    }
  else
    lines[prompt_line].text = text;
  local.s;
  for (s = 0; s < SLOTS; s++)
    global.slot[s].settled = 0;
}

fun display_password_callback(prompt, bullets)
{
  if (!prompt)
    prompt = "PASSPHRASE";
  show_prompt(prompt + " " + repeat("*", bullets));
}

fun display_question_callback(prompt, entry)
{
  show_prompt(prompt + " " + entry);
}

fun display_normal_callback()
{
  if (prompt_line >= 0)
    {
      lines[prompt_line].kind = "final";
      lines[prompt_line].text = "ACCESS GRANTED";
      lines[prompt_line].born = t;
      local.s;
      for (s = 0; s < SLOTS; s++)
        global.slot[s].settled = 0;
      global.prompt_line = -1;
    }
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetSystemUpdateFunction(system_update_callback);
Plymouth.SetRootMountedFunction(root_mounted_callback);
Plymouth.SetUpdateStatusFunction(update_status_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
