// Orbiter's fastfetch: the wallpaper's Earth beside bracketed labels like the
// bar's, and meters drawn the way its toggles are ([▮▮▮···]). Like fish's
// colours, every colour is one of the terminal's 16 named ones (90 is bright
// black), so switching variants recolours it through Konsole's palette.
// apply-theme.sh installs this as ~/.config/fastfetch/config.jsonc, keeping
// any earlier one as config.jsonc.orbiter-backup.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // Baked by tools/bake_fastfetch_logo.py.
    "source": "~/.config/fastfetch/orbiter-logo.txt",
    "type": "file",
    "color": { "1": "blue", "2": "yellow", "3": "90", "4": "white" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": " ",
    "brightColor": false,
    "key": { "width": 10 },
    "color": { "keys": "white", "output": "default", "title": "blue" },
    "bar": {
      "char": { "elapsed": "▮", "total": "·" },
      "border": { "left": "[", "right": "]" },
      "width": 10,
      "color": { "elapsed": "yellow", "total": "90", "border": "yellow" }
    },
    "percent": {
      "type": ["bar", "num"],
      "color": { "green": "green", "yellow": "yellow", "red": "red" }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": { "user": "blue", "at": "yellow", "host": "blue" }
    },
    { "type": "custom", "format": "{#90}──────────────────────────────" },
    { "type": "os", "key": "{#yellow}[{#white}OS{#yellow}]", "format": "{pretty-name} {arch}" },
    { "type": "kernel", "key": "{#yellow}[{#white}KERNEL{#yellow}]", "format": "{release}" },
    { "type": "uptime", "key": "{#yellow}[{#white}UPTIME{#yellow}]" },
    { "type": "packages", "key": "{#yellow}[{#white}PKGS{#yellow}]" },
    { "type": "shell", "key": "{#yellow}[{#white}SHELL{#yellow}]" },
    { "type": "de", "key": "{#yellow}[{#white}DESKTOP{#yellow}]", "format": "{pretty-name} {version}" },
    {
      // The active variant, from the colour scheme Plasma has applied.
      "type": "command",
      "key": "{#yellow}[{#white}THEME{#yellow}]",
      "text": "kreadconfig6 --file kdeglobals --group General --key ColorScheme | sed 's/^Orbiter\\(.\\)/Orbiter \\1/'"
    },
    { "type": "terminalfont", "key": "{#yellow}[{#white}FONT{#yellow}]" },
    { "type": "custom", "format": "{#90}──────────────────────────────" },
    { "type": "cpu", "key": "{#yellow}[{#white}CPU{#yellow}]" },
    { "type": "gpu", "key": "{#yellow}[{#white}GPU{#yellow}]", "format": "{name}" },
    { "type": "memory", "key": "{#yellow}[{#white}MEMORY{#yellow}]", "format": "{percentage-bar} {used} / {total}" },
    {
      "type": "disk",
      "key": "{#yellow}[{#white}DISK{#yellow}]",
      "folders": "/",
      "format": "{size-percentage-bar} {size-used} / {size-total}"
    },
    { "type": "battery", "key": "{#yellow}[{#white}BATTERY{#yellow}]", "format": "{capacity-bar} {capacity} {status}" },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 0 }
  ]
}
